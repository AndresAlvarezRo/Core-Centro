# Core-Hogar — environment template
# Copy to .env and adjust as needed.

# Service
PORT=6100
NODE_ENV=development

# JWT — MUST match Centro-Hogar's JWT_SECRET so the same token validates here.
JWT_SECRET=centro_hogar_super_secret_2026

# Database (shared with the suite — Postgres `homelearn`)
DB_HOST=localhost
DB_PORT=5432
DB_USER=homelearn_user
DB_PASS=homelearn_pass
DB_NAME=homelearn
